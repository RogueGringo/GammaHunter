.venv/
__pycache__/
*.egg-info/
dist/
build/
data/*.jsonl
!data/.gitkeep
artifacts/*.jsonl
# ...except the step-by-step generations behind artifacts/llm_cot.json (kept for audit)
!artifacts/llm_cot*generations.jsonl
# ...and the replies behind artifacts/llm_reader.json
!artifacts/llm_reader*generations.jsonl
!artifacts/.gitkeep
.pytest_cache/

# Provenance bundles are kept outside the repository
*.bundle
*.bundle.sha256

# Third-party benchmark downloads (kept out of the repository)
data/benchmarks/

# take-off study checkpoints (hashes are recorded in artifacts/takeoff_study.json)
artifacts/takeoff/

# reader-pipeline checkpoints (hashes are recorded in artifacts/reader_pipeline.json)
artifacts/reader_pipeline/
